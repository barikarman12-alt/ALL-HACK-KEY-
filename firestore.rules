rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Authenticated users and owner can read user profile
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
    }
    match /appData/{document=**} {
      // Anyone can read
      allow read: if true;
      // Only owner can write
      allow write: if request.auth != null && (request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
    }
    match /purchases/{purchaseId} {
      // Users can only read their own purchases, owner can read all purchases
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
      // Users can write a purchase (we're processing on client)
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.userId || request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
    }
    match /walletTransactions/{transactionId} {
      // Users can read their own transactions, owner can read all transactions
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
      // Owner or authenticated user can write
      allow write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      // Users can read their own notifications, owner can read all
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.email == 'barikarman207@gmail.com' || request.auth.token.email == 'barikarman12@gmail.com');
      // Owner or system can write
      allow write: if request.auth != null;
    }
  }
}
