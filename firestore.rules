rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Anyone authenticated can read user profile
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /appData/{document=**} {
      // Anyone can read appData settings/coupons/inventory
      allow read, write: if true;
    }
    match /coupons/{couponId} {
      // Anyone can read and update coupons
      allow read, write: if true;
    }
    match /purchases/{purchaseId} {
      // Users can read their own purchases, owner can read all purchases
      allow read: if request.auth != null;
      // Users can write a purchase
      allow write: if request.auth != null;
    }
    match /walletTransactions/{transactionId} {
      // Users can read and write transactions
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /notifications/{notificationId} {
      // Users can read and write notifications
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /pendingOrders/{orderId} {
      // Users can read and manage their pending orders
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    match /test/{document=**} {
      allow read, write: if true;
    }
  }
}

