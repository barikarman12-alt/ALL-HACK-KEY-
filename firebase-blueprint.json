{
  "collections": {
    "users": {
      "description": "User accounts created via Google Sign-In.",
      "schema": {
        "uid": "string",
        "email": "string",
        "displayName": "string",
        "photoURL": "string",
        "lastLoginAt": "timestamp"
      }
    },
    "appData": {
      "description": "Global application data like inventory and settings.",
      "schema": {
        "id": "string",
        "inventory": "array",
        "settings": "map"
      }
    },
    "purchases": {
      "description": "History of user purchases.",
      "schema": {
        "id": "string",
        "userId": "string",
        "value": "string",
        "category": "string",
        "label": "string",
        "keys": "array",
        "date": "timestamp"
      }
    },
    "walletTransactions": {
      "description": "Records of user balance additions, deposits, refunds, and adjustments.",
      "schema": {
        "id": "string",
        "userId": "string",
        "userEmail": "string",
        "type": "string",
        "amount": "number",
        "method": "string",
        "referenceId": "string",
        "note": "string",
        "date": "timestamp",
        "status": "string"
      }
    },
    "notifications": {
      "description": "User notifications including refund credits, order updates, and alerts.",
      "schema": {
        "id": "string",
        "userId": "string",
        "title": "string",
        "message": "string",
        "type": "string",
        "amount": "number",
        "read": "boolean",
        "date": "timestamp"
      }
    },
    "pendingOrders": {
      "description": "Pending payment gateway orders for users, allowing auto-verification and auto-credit on re-login.",
      "schema": {
        "id": "string",
        "orderId": "string",
        "userId": "string",
        "userEmail": "string",
        "type": "string",
        "amount": "number",
        "status": "string",
        "productName": "string",
        "durationLabel": "string",
        "durationValue": "string",
        "quantity": "number",
        "couponCode": "string",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      }
    }
  }
}
